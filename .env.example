# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OWNER_INITIAL_PASSWORD: Secret initial password for the sole OWNER account (veloracute552@gmail.com).
# Set this securely via environment secrets. Never commit real passwords.
OWNER_INITIAL_PASSWORD=""

# SESSION_SECRET: High-entropy secret for signing session tokens and encrypting stored SMTP secrets.
SESSION_SECRET=""

# Optional SMTP configuration for real email verification & password reset delivery
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LUXURY HAVE <noreply@luxuryhave.local>"
